
import java.io.File;
import java.util.Scanner;

public class CustomerDataStructure {

    private BSTMap<Integer, CustomerNode> customersTree;

    public CustomerDataStructure() {
        customersTree = new BSTMap<>();
    }

    public boolean addCustomer(CustomerNode c) {
        boolean inserted = customersTree.insert(c.getCustomerID(), c);
        if (inserted)
            System.out.println("✔ Customer added: " + c.getName());
        else
            System.out.println("✘ Customer ID already exists");
        return inserted;
    }

    public CustomerNode searchById(int id) {
        if (customersTree.find(id))
            return customersTree.retrieve();
        return null;
    }

    public void displayAll() {
        if (customersTree.empty()) {
            System.out.println("✘ No customers found");
            return;
        }

        System.out.println("✦ All Customers Sorted by ID ✦");
        printCustomersInOrder();
    }

    private void printCustomersInOrder() {
        inOrderPrint(customersTree.getRoot());
    }

    private void inOrderPrint(BSTnode<Integer, CustomerNode> p) {
        if (p == null) return;
        inOrderPrint(p.left);
        p.data.display();
        inOrderPrint(p.right);
    }

    public void loadCustomers(String fileName) {
        try {
            File f = new File(fileName);
            Scanner read = new Scanner(f);
            System.out.println("Reading customers from: " + fileName);

            if (read.hasNextLine()) read.nextLine();

            while (read.hasNextLine()) {
                String line = read.nextLine().trim();
                if (!line.isEmpty()) {
                    CustomerNode c = ConvertStringToCustomer(line);
                    customersTree.insert(c.getCustomerID(), c);
                }
            }

            read.close();
            System.out.println("✔ Customers loaded successfully");

        } catch (Exception e) {
            System.out.println("✘ Error loading customers: " + e.getMessage());
        }
    }

    public static CustomerNode ConvertStringToCustomer(String line) {
        String a[] = line.split(",");
        return new CustomerNode(
            Integer.parseInt(a[0].trim()),
            a[1].trim(),
            a[2].trim()
        );
    }

    public void printOrderHistory(int id) {
        CustomerNode c = searchById(id);
        if (c == null) {
            System.out.println("✘ Customer not found");
        } else {
            c.printOrderHistory();
        }
    }

    // ⭐⭐⭐ Requirement: List all customers alphabetically
    public void printCustomersAlphabetically() {
        if (customersTree.empty()) {
            System.out.println("✘ No customers available");
            return;
        }

        System.out.println("✦ Customers Sorted Alphabetically ✦");

        printAlphabetically(customersTree.getRoot());
    }

    private void printAlphabetically(BSTnode<Integer, CustomerNode> p) {
        if (p == null) return;

        printAlphabetically(p.left);
        printAlphabetically(p.right);

       
        System.out.println("Customer: " + p.data.getName() +
                           " (ID " + p.key + ")");
    }
}
